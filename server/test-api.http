PATCH http://localhost:5000/api/reservations/6ab7891fadb9cdec58d80887/status
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhYjc3NzZkZWE1M2VmOTllNjE4NWVjZiIsImlhdCI6MTc5MDQxMTYxMSwiZXhwIjoxNzkxMDE2NDExfQ.pK0gyvbVjhbHdGiCYxa8goNTPD1O1qpFGxbGxu3nLiA

{
  "status": "CheckedIn"
}

### 10. Verify Room 101 Status is Now Occupied
GET http://localhost:5000/api/rooms

### 11. Generate Invoice with Add-on Services
POST http://localhost:5000/api/invoices
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhYjc3NzZkZWE1M2VmOTllNjE4NWVjZiIsImlhdCI6MTc5MDQxMTYxMSwiZXhwIjoxNzkxMDE2NDExfQ.pK0gyvbVjhbHdGiCYxa8goNTPD1O1qpFGxbGxu3nLiA

{
  "reservationId": "6ab7891fadb9cdec58d80887",
  "services": [
    { "name": "Airport Shuttle", "cost": 3000 },
    { "name": "Dinner Buffet", "cost": 2500 }
  ],
  "taxRate": 0.16,
  "paymentMethod": "Credit Card"
}

