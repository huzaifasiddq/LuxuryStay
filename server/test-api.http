### 1. Test Server Root
GET http://localhost:5000/

### 2. Register Admin User
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "name": "Super Admin",
  "email": "admin@luxurystay.com",
  "password": "adminpassword123",
  "role": "Admin",
  "phone": "+923001234567"
}

### 3. Login Admin User
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "admin@luxurystay.com",
  "password": "adminpassword123"
}

### 1. Get All Rooms (Public - Check if empty or existing)
GET http://localhost:5000/api/rooms

### 2. Create Room 101 (Admin Protected)
POST http://localhost:5000/api/rooms
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhYjc3NzZkZWE1M2VmOTllNjE4NWVjZiIsImlhdCI6MTc5MDQxMTYxMSwiZXhwIjoxNzkxMDE2NDExfQ.pK0gyvbVjhbHdGiCYxa8goNTPD1O1qpFGxbGxu3nLiA

{
  "roomNumber": "101",
  "roomType": "Deluxe",
  "pricePerNight": 12000,
  "status": "Available",
  "floor": 1,
  "features": ["Wi-Fi", "AC", "Smart TV", "Balcony"]
}

### 3. Create Room 102 (Admin Protected)
POST http://localhost:5000/api/rooms
Content-Type: application/json
Authorization: Bearer YOUR_ADMIN_TOKEN_HERE

{
  "roomNumber": "102",
  "roomType": "Suite",
  "pricePerNight": 25000,
  "status": "Available",
  "floor": 1,
  "features": ["Wi-Fi", "AC", "Sea View", "Mini Bar", "Jacuzzi"]
}

### 4. Get Available Rooms Only (Filter Query)
GET http://localhost:5000/api/rooms?status=Available

### 5. Create New Guest (Admin/Receptionist Protected)
POST http://localhost:5000/api/guests
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhYjc3NzZkZWE1M2VmOTllNjE4NWVjZiIsImlhdCI6MTc5MDQxMTYxMSwiZXhwIjoxNzkxMDE2NDExfQ.pK0gyvbVjhbHdGiCYxa8goNTPD1O1qpFGxbGxu3nLiA

{
  "fullName": "Ahmed Khan",
  "email": "ahmed.khan@example.com",
  "phone": "+923211234567",
  "idType": "CNIC",
  "idNumber": "42101-1234567-1",
  "country": "Pakistan",
  "address": "Gulshan-e-Iqbal, Karachi",
  "specialPreferences": "High floor, quiet room"
}

