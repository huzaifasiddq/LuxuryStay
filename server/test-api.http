POST http://localhost:5000/api/reservations
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhYjc3NzZkZWE1M2VmOTllNjE4NWVjZiIsImlhdCI6MTc5MDQxMTYxMSwiZXhwIjoxNzkxMDE2NDExfQ.pK0gyvbVjhbHdGiCYxa8goNTPD1O1qpFGxbGxu3nLiA

{
  "guestId": "6ab786af813403f83a43a6c6",
  "roomId": "6ab78413a4d15d4b78c1bd37",
  "checkInDate": "2026-10-01T14:00:00.000Z",
  "checkOutDate": "2026-10-03T11:00:00.000Z"
}

### 8. Get All Reservations (Populated Guest & Room)
GET http://localhost:5000/api/reservations
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhYjc3NzZkZWE1M2VmOTllNjE4NWVjZiIsImlhdCI6MTc5MDQxMTYxMSwiZXhwIjoxNzkxMDE2NDExfQ.pK0gyvbVjhbHdGiCYxa8goNTPD1O1qpFGxbGxu3nLiA

